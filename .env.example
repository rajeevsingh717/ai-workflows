# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — if absent, falls back to DuckDuckGo (no key needed)
# Get one free at https://tavily.com
TAVILY_API_KEY=tvly-...

# === Photo organizer workflow ===
# GCS bucket where ARCHIVE_GCP photos are uploaded
GCS_BUCKET=your-photo-archive-bucket

# Absolute path to a GCP service-account JSON key with Storage Object Admin
# on the bucket above. If unset, the workflow falls back to ADC.
GOOGLE_APPLICATION_CREDENTIALS=/Users/rajeevsingh/.config/gcp/photo-archiver-sa.json
