# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — if absent, falls back to DuckDuckGo (no key needed)
# Get one free at https://tavily.com
TAVILY_API_KEY=tvly-...

# === Photo organizer workflow ===
# GCS bucket where ARCHIVE_GCP photos are uploaded
GCS_BUCKET=your-photo-archive-bucket

# Absolute path to a GCP service-account JSON key with Storage Object Admin
# on the bucket above. If unset, the workflow falls back to ADC.
GOOGLE_APPLICATION_CREDENTIALS=/Users/rajeevsingh/.config/gcp/photo-archiver-sa.json

# === Portfolio market-check workflow ===
# Free key from https://finnhub.io/register (free tier: 60 calls/min, plenty for ~40 symbols)
FINNHUB_API_KEY=your-finnhub-key

# Optional — sends the market_check.py summary to Telegram instead of just a
# local file. Create a bot via @BotFather in Telegram for the token; get the
# chat_id by messaging the bot once (or posting in a channel it admins) and
# calling https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
